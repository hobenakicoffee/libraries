{
  "name": "@hobenakicoffee/libraries",
  "version": "8.19.0",
  "license": "MIT",
  "type": "module",
  "types": "src/index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/hobenakicoffee/libraries"
  },
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants/index.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./moderation": "./src/moderation/index.ts",
    "./types": "./src/types/index.ts",
    "./utils": "./src/utils/index.ts",
    "./nuqs": "./src/nuqs/index.ts",
    "./scripts": "./src/scripts/index.ts",
    "./hooks": "./src/hooks/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck",
    "format": "ultracite fix",
    "format:check": "ultracite check",
    "format:doctor": "ultracite doctor",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run test",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "check:env": "bun run src/scripts/check-env-encryption.ts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "lefthook": "^2.1.9",
    "ultracite": "7.2.3"
  },
  "peerDependencies": {
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "nuqs": "^2.8.9",
    "obscenity": "^0.4.6",
    "openai": "^6.44.0",
    "react": "^19.2.7",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  }
}
