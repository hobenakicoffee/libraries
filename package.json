{
  "name": "@hobenakicoffee/libraries",
  "version": "8.12.0",
  "license": "MIT",
  "type": "module",
  "types": "src/index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/hobenakicoffee/libraries"
  },
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants/index.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./moderation": "./src/moderation/index.ts",
    "./types": "./src/types/index.ts",
    "./utils": "./src/utils/index.ts",
    "./nuqs": "./src/nuqs/index.ts",
    "./scripts": "./src/scripts/index.ts",
    "./hooks": "./src/hooks/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "dev": "vite",
    "dev:docs": "vitepress dev",
    "build:app": "tsc -b && vite build",
    "build:docs": "vitepress build",
    "build": "bun run build:app && bun run build:docs && cp -r .vitepress/dist dist/docs",
    "preview:app": "vite preview",
    "preview:docs": "vitepress preview --port 8080",
    "preview": "bun run preview:app",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck",
    "format": "ultracite fix",
    "format:check": "ultracite check",
    "format:doctor": "ultracite doctor",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run test",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "check:env": "bun run src/scripts/check-env-encryption.ts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "@mermaid-js/mermaid-mindmap": "^9.3.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "lefthook": "^2.1.9",
    "mermaid": "^11.15.0",
    "ultracite": "7.2.3",
    "vite": "^8.0.16",
    "vite-tsconfig-paths": "^6.1.1",
    "vitepress": "^2.0.0-alpha.17",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "peerDependencies": {
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-bengali": "^5.2.11",
    "@tailwindcss/vite": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "install": "^0.13.0",
    "nuqs": "^2.8.9",
    "obscenity": "^0.4.6",
    "openai": "^6.44.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  }
}
